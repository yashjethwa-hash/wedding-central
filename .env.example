# Web3Forms access key for the contact form at /contact.
# Get one free at https://web3forms.com: enter the address you want messages
# delivered to and the key arrives by email.
#
# Copy this file to .env.local for development, and set the same variable on
# the host for production. NEXT_PUBLIC_ means the value ships in the client
# bundle, which is how Web3Forms works: the browser posts straight to their
# endpoint, with no backend, which is what lets this run under a static export.
NEXT_PUBLIC_WEB3FORMS_KEY=YOUR_WEB3FORMS_ACCESS_KEY
